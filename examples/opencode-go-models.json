{
  // ════════════════════════════════════════════════════════════════════
  //  OpenCode Go 常见模型配置样例
  //
  //  客户端 Base URL 填：http://127.0.0.1:9355/zen/go/v1
  //  模型名按下面 model.map 的键来写，加不加 proxy- 前缀都可以：
  //    "glm"          → glm-5.3
  //    "proxy-glm"    → glm-5.3   （先剥前缀、再查映射）
  //    "glm-5.3"      → glm-5.3   （直接写真实名也放行）
  //
  //  用 Trae 时建议一律加 proxy- 前缀：它按模型 ID 决定走不走自定义通道，
  //  填内置预设名（如 glm-5.3）会被它自己的云通道截走，绕过本代理。
  //
  //  从 v0.2.0 起，下面这张 model.map **已经内置在程序里**了（见 src/models.js），
  //  所以不加 -c 也能直接用这些别名。本文件保留为「把每一项显式写全」的参考，
  //  也方便你在上面覆盖个别条目——配置文件里的 map 会与内置表逐键合并。
  //
  //  从 v0.2.1 起还能按请求性质分桶：把长上下文、后台任务、思考型请求分别送到不同
  //  模型（见 model 段下面注释掉的 "router" 段）。不打开就与以前完全一样。
  //
  //  从 v0.2.2 起支持协议互转：客户端只说一种协议也能调到说另一种协议的模型
  //  （见下面注释掉的 "protocol" 段）。默认关闭。
  //
  //  从 v0.3.0 起多出两件事：按请求难度分桶（router.scorers + router.bands，
  //  见下面注释掉的 "router" 段），以及把请求发到不同的上游（upstreams 段，
  //  可以把 Copilot 托管的模型和你自己付费的模型放进同一个池子）。
  //
  //  启动：llm-session-proxy -c examples/opencode-go-models.json
  // ════════════════════════════════════════════════════════════════════

  "listen": { "host": "127.0.0.1", "port": 9355 },

  "upstream": {
    "protocol": "https",
    "host": "opencode.ai",
    "port": null,
    "basePath": ""
  },

  "request": {
    "bufferBody": true,
    "maxBodyBytes": 67108864,
    "timeoutMs": 600000,
    "pathRewrite": [],
    "dropHeaders": [],
    "forwardClientSessionHeaders": true
  },

  "session": {
    "enabled": true,
    "headerNames": ["x-opencode-session", "x-session-id", "x-conversation-id", "x-thread-id"],
    "bodyFields": ["session_id", "sessionId", "conversation_id", "conversationId"],
    "contentHash": {
      "enabled": true,
      "fields": ["system", "system_instruction", "instructions"],
      "includeFirstUserMessage": true
    },
    "idPrefix": "ses_",
    "idFormat": "hex26",
    "requestIdFormat": "msg_{{session.count}}",
    "maxSessions": 512,
    "ttlSeconds": 0
  },

  "inject": {
    "headers": {
      "x-opencode-session": "{{session.id}}",
      "x-opencode-request": "{{session.requestId}}",
      "x-opencode-client": "cli",
      "x-opencode-project": "global"
    },
    "body": {},
    "removeBodyFields": [],
    "overwrite": true
  },

  "model": {
    "enabled": true,
    "field": "model",
    "stripPrefixes": ["proxy-"],

    "map": {
      // ── 端点 /zen/go/v1/chat/completions（OpenAI 兼容，绝大多数客户端走这条）──
      "glm": "glm-5.3",
      "glm-flash": "glm-5.3-flash",
      "glm-5.2": "glm-5.2",
      "glm-5.1": "glm-5.1",
      "kimi": "kimi-k3",
      "kimi-code": "kimi-k2.7-code",
      "kimi-k2.6": "kimi-k2.6",
      "deepseek": "deepseek-flash",
      "deepseek-pro": "deepseek-v4-pro",
      "deepseek-v4-flash": "deepseek-v4-flash",
      "deepseek-vision": "deepseek-v4-flash-vision-exp",
      "longcat": "longcat-2.0",
      "mimo": "mimo-v2.5",
      "mimo-pro": "mimo-v2.5-pro",
      "hy3": "hy3",
      "hy4": "hy4-preview"

      // ── 端点 /zen/go/v1/responses（OpenAI Responses API）──
      // 客户端必须支持 Responses 协议，用 OpenAI Chat Completions 格式调用会被上游拒绝。
      // "grok": "grok-4.6",
      // "gpt-luna": "gpt-5.6-luna",
      // "muse-1.3": "muse-spark-1.3-contributor",
      // "muse-1.2": "muse-spark-1.2-contributor"

      // ── 端点 /zen/go/v1/messages（Anthropic Messages API）──
      // 客户端必须能发 Anthropic 格式的请求体。若客户端只支持 OpenAI 格式，
      // 本代理不做协议转换，这些模型用不了。
      // "minimax": "minimax-m3",
      // "minimax-2.7": "minimax-m2.7",
      // "minimax-2.5": "minimax-m2.5",
      // "qwen-max": "qwen3.8-max",
      // "qwen-flash": "qwen3.8-flash",
      // "qwen3.7-max": "qwen3.7-max",
      // "qwen-plus": "qwen3.6-plus"
    },

    // 客户端填了映射表里没有、也剥不掉前缀的名字时，是否兜底到某个模型
    "default": null,

    // 别名剥完前缀既无映射也无 default 时，每个别名告警一次（带上该补哪一条）
    "warnUnmapped": true
  },

  // ── v0.2.1 起可选：请求体变换与分桶路由 ────────────────────────────────
  // 两者都默认不生效（transformers.enabled 为空、router.enabled 为 false），
  // 所以整段注释掉时行为与 v0.2.0 完全一致。
  //
  // 规则自上而下求值、首个命中即止；同一条规则内的多个条件是「与」。
  // 大小阈值一律按**字节**（请求体字节数），刻意不估 token——估 token 要带分词器。
  // path 比对的是客户端发来的路径（早于 request.pathRewrite）。
  //
  // "transformers": {
  //   "enabled": ["drop-empty-fields"],          // 全局生效，与走哪个桶无关
  //   "options": {
  //     "drop-empty-fields": { "fields": ["temperature", "top_p"] },
  //     "clamp-max-tokens": { "max": 4096 }
  //   }
  // },
  //
  // "router": {
  //   "enabled": true,
  //   "defaultBucket": "default",
  //   "buckets": {
  //     "think":       { "model": "glm-5.3-think" },
  //     "longContext": { "model": "glm-5.3-long" },
  //     "background":  { "model": "glm-5.3-flash", "transformers": ["clamp-max-tokens"] }
  //   },
  //   "rules": [
  //     { "bucket": "think",       "path": "/zen/go/v1/messages" },
  //     { "bucket": "longContext", "minBytes": 60000 },
  //     { "bucket": "background",  "modelPrefix": "proxy-glm-flash", "maxBytes": 4096 }
  //   ]
  // },
  //
  // ── v0.3.0 起可选：按难度打分 ──────────────────────────────────────────
  // 打分器把请求的**形态**折成一个 0–100 分与档位，规则就能按 difficulty 匹配。
  // 它是本地确定性算法，不调模型、不发网络请求。注意它衡量的是形态不是语义：
  // 长上下文里的短问题照样算难。
  //
  // 不配 scorers 时 difficulty 规则永远不命中（与「零条件规则不命中」同款语义）。
  //
  // "scorers": { "enabled": ["builtin-complexity"] },
  // "bands": [
  //   { "name": "easy",   "maxScore": 30 },
  //   { "name": "medium", "maxScore": 60 },
  //   { "name": "hard",   "maxScore": 100 }
  // ],
  //
  // 然后规则里就能写难度了（可以和其它条件同时用，条件之间是「与」）：
  //
  // "rules": [
  //   { "bucket": "think",       "difficulty": "hard" },
  //   { "bucket": "background",  "difficulty": "easy" }
  // ],

  // ── v0.2.2 起可选：协议互转 ────────────────────────────────────────────
  // 从请求路径推断客户端协议（/chat/completions → chat、/messages → messages、
  // /responses → responses、:generateContent → gemini），路由决定上游说哪套；
  // 两者不同时自动转换请求体与响应，SSE 按事件逐条转码。默认关闭。
  // target 只能是 chat | messages | responses | gemini。
  //
  // "protocol": {
  //   "enabled": true,
  //   "paths": {
  //     "chat": "/zen/go/v1/chat/completions",
  //     "messages": "/zen/go/v1/messages",
  //     "responses": "/zen/go/v1/responses"
  //   },
  //   "routes": [
  //     { "model": "minimax", "target": "messages" },
  //     { "model": "gpt", "target": "responses" }
  //   ]
  // },
  //
  // ── v0.3.0 起可选：上游池 ──────────────────────────────────────────────
  // 一个进程里放多个上游，各带各的端点路径、线协议与凭据来源。
  // 选择顺序：桶里显式写的 "upstream" > 按模型名前缀匹配的 "routes" > "default"；
  // 都不命中就退回上面那个顶层 "upstream"，所以打开池子不会弄坏现有配置。
  //
  // 凭据**只写来源、不写值**：auth.env 是环境变量名（可逗号分隔多个），
  // auth.command 的 stdout 就是 key（不经 shell 展开），auth.deviceFlow 允许设备流登录。
  // 凭据值运行时现取，绝不写进配置文件、绝不进日志。
  //
  // Copilot 侧走官方链路：GitHub token → copilot_internal/v2/token → 短期 session token。
  // GitHub token 的查找顺序是 COPILOT_GITHUB_TOKEN → GH_TOKEN → GITHUB_TOKEN →
  // gh CLI → 设备流登录。注意 ghp_ 传统 PAT 不被 GitHub 支持用于 Copilot，
  // github_pat_ / ghu_ / gho_ / ghs_ 才支持。
  //
  // "upstreams": {
  //   "providers": {
  //     "copilot": {
  //       "type": "copilot",
  //       "baseUrl": "https://api.githubcopilot.com",
  //       "auth": { "env": "COPILOT_GITHUB_TOKEN", "deviceFlow": true }
  //     },
  //     "own": {
  //       "type": "openai",
  //       "baseUrl": "https://api.openai.com/v1",
  //       "auth": { "env": "OPENAI_API_KEY" }
  //     }
  //   },
  //   "routes": [
  //     { "model": "gpt-5", "upstream": "copilot" }
  //   ],
  //   "default": "own"
  // },

  "userAgent": "opencode/1.18.29 cli",
  "userAgentMode": "replace-generic",

  "response": { "stream": true },

  "log": {
    "level": "info",
    "file": null,                 // null = 默认位置 ~/.lsp/logs/llm-session-proxy.log；false = 不落盘
    "rotate": "size",             // size | daily | off
    "maxBytes": 5242880,
    "backups": 2,
    "keepDays": 30                // 超过 30 天的历史日志自动删除，0 表示永久保留
  }
}
