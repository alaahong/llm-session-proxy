{
  "name": "llm-session-proxy",
  "version": "0.2.1",
  "description": "A configurable local reverse proxy for LLM APIs: generates or forwards session IDs, injects arbitrary headers, and rewrites model aliases and request paths. Zero dependencies. Built so clients that cannot send a required session header (such as x-opencode-session) can still talk to upstreams that demand it.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "alaahong",
  "homepage": "https://www.ianzhang.cn/llm-session-proxy/",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alaahong/llm-session-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/alaahong/llm-session-proxy/issues"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "llm-session-proxy": "bin/llm-session-proxy.js"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README.md",
    "README-zh-CN.md",
    "ROADMAP.md",
    "ROADMAP.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node ./bin/llm-session-proxy.js",
    "test": "node --test",
    "prepack": "node ./scripts/check-pack.mjs"
  },
  "keywords": [
    "proxy",
    "llm",
    "reverse-proxy",
    "session-id",
    "header-injection",
    "opencode",
    "opencode-go",
    "trae",
    "anthropic",
    "openai",
    "codex",
    "claude-code",
    "x-opencode-session",
    "local-proxy",
    "sse"
  ],
  "publishConfig": {
    "access": "public"
  }
}
